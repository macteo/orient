{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orient.example/content/schema/esclusi.schema.json",
  "title": "Esclusi",
  "description": "Cosa un parser ha deliberatamente lasciato fuori: content/esclusi/descrizioni.json (voci {rif, motivo, fonte}) o content/esclusi/isom.json (voci {tipo, rif|nome|file, motivo}).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "esclusi"],
  "properties": {
    "v": { "const": 1 },
    "generato": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sorgente": { "type": "string", "enum": ["S1", "S3"] },
    "esclusi": {
      "type": "array",
      "items": { "$ref": "#/$defs/escluso" }
    }
  },
  "$defs": {
    "escluso": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motivo"],
      "anyOf": [{ "required": ["fonte"] }, { "required": ["tipo"] }],
      "properties": {
        "rif": { "type": "string", "minLength": 1 },
        "nome": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "motivo": { "type": "string", "minLength": 1 },
        "fonte": { "type": "string", "enum": ["S1", "S3"] },
        "tipo": { "type": "string", "enum": ["simbolo", "figura", "variante"] }
      }
    }
  }
}
