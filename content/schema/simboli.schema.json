{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orient.example/content/schema/simboli.schema.json",
  "title": "Simboli",
  "description": "Un Simbolo per pittogramma: content/simboli/descrizioni-punti.json (fonte S3) o content/simboli/isom.json (fonte S1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "generato", "sorgente", "simboli"],
  "properties": {
    "v": { "const": 1 },
    "generato": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sorgente": { "type": "string", "enum": ["S1", "S3"] },
    "simboli": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/simbolo" }
    }
  },
  "$defs": {
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "formato", "origine", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^content/artwork/(descrizioni-punti|isom)/[^/]+\\.(svg|png)$"
        },
        "formato": { "type": "string", "enum": ["svg", "png"] },
        "origine": { "type": "string", "enum": ["S3", "S4", "S5"] },
        "sha256": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
        "condiviso": { "type": "string", "minLength": 1 }
      }
    },
    "simbolo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rif", "fonte", "sezione", "nome", "descrizione", "pagina", "artwork"],
      "properties": {
        "rif": { "type": "string", "pattern": "^\\d{1,3}(\\.\\d{1,2})?$" },
        "fonte": { "type": "string", "enum": ["S1", "S3"] },
        "sezione": { "type": "string", "minLength": 1 },
        "nome": { "type": "string", "minLength": 1 },
        "descrizione": { "type": "string", "minLength": 1 },
        "colonna": { "type": "string", "enum": ["C", "D", "E", "F", "G", "H"] },
        "famiglia": { "type": "string", "minLength": 1 },
        "direzioni": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"] }
        },
        "isom": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^\\d{3}$" }
        },
        "geometria": { "type": "string", "enum": ["L", "P", "A", "T"] },
        "pagina": { "type": "integer", "minimum": 1 },
        "artwork": { "$ref": "#/$defs/artwork" }
      }
    }
  }
}
