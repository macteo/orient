{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orient.example/content/schema/fonti.schema.json",
  "title": "Fonti",
  "description": "Registro delle licenze: ogni fonte che orient riproduce, con la licenza e cosa se ne usa.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "contatto", "fonti"],
  "properties": {
    "v": {
      "const": 1
    },
    "contatto": {
      "type": "string",
      "format": "email",
      "minLength": 1
    },
    "fonti": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/fonte" }
    }
  },
  "$defs": {
    "licenza": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome"],
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "testoFile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*\\.(txt|md)$"
        }
      },
      "anyOf": [
        { "required": ["url"] },
        { "required": ["testoFile"] }
      ]
    },
    "fonte": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "titolo", "autori", "licenza", "cosaUsiamo", "attribuzione"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "s3-descrizioni",
            "s4-purple-pen",
            "s1-isom",
            "s5-isom-illustrazioni",
            "preline",
            "fonts"
          ]
        },
        "titolo": { "type": "string", "minLength": 1 },
        "autori": { "type": "string", "minLength": 1 },
        "editore": { "type": "string", "minLength": 1 },
        "edizione": { "type": "string", "minLength": 1 },
        "data": { "type": "string", "minLength": 1 },
        "licenza": { "$ref": "#/$defs/licenza" },
        "cosaUsiamo": { "type": "string", "minLength": 1 },
        "attribuzione": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
