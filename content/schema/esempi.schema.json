{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orient.example/content/schema/esempi.schema.json",
  "title": "Esempi",
  "description": "content/esempi/esempi.json (elenco Esempio) o content/esempi/sezioni.json (mappa pagina -> famiglia).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v"],
  "anyOf": [{ "required": ["esempi"] }, { "required": ["pagine"] }],
  "properties": {
    "v": { "const": 1 },
    "generato": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sorgente": { "type": "string", "enum": ["S3"] },
    "nota": { "type": "string", "minLength": 1 },
    "esempi": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/esempio" }
    },
    "pagine": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "esempio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codice", "pagina", "famiglia", "testo", "carta", "terreno", "riga"],
      "properties": {
        "codice": { "type": "string", "minLength": 1 },
        "pagina": { "type": "integer", "minimum": 1 },
        "famiglia": { "type": "string", "minLength": 1 },
        "testo": { "type": "string", "minLength": 1 },
        "carta": { "type": "string", "pattern": "^content/artwork/esempi/.+\\.png$" },
        "terreno": { "type": "string", "pattern": "^content/artwork/esempi/.+\\.png$" },
        "riga": { "type": "string", "pattern": "^content/artwork/esempi/.+\\.png$" },
        "nascondi": { "type": "boolean" }
      }
    }
  }
}
